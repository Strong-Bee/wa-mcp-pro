# WA-MCP Pro Environment Configuration
# Copy this file to .env and adjust values.

NODE_ENV=development
APP_NAME=WA-MCP-Pro
APP_VERSION=1.0.0

# Server
HOST=127.0.0.1
PORT=3000

# MCP Transport
MCP_TRANSPORT=stdio
MCP_HTTP_ENABLED=false
MCP_HTTP_PORT=3001

# Database and storage
DATABASE_URL=./storage/wa-mcp.db
SESSION_DIRECTORY=./storage/sessions
MEDIA_DIRECTORY=./storage/media
LOG_DIRECTORY=./storage/logs

# Generate a 32-byte key with: openssl rand -hex 32
# Required before linking WhatsApp accounts.
ENCRYPTION_KEY=

# Logging and limits
LOG_LEVEL=info
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
MAX_MEDIA_SIZE_MB=50

# WhatsApp connection
WHATSAPP_AUTO_RECONNECT=true
WHATSAPP_RECONNECT_MAX_ATTEMPTS=10
WHATSAPP_MESSAGE_HISTORY_LIMIT=10000

# Generate API credentials explicitly:
# pnpm generate:api-key -- --name "Local Agent" --permissions "accounts:read,messages:send"
