# WA-MCP Pro Environment Configuration
# Copy this file to .env and adjust values

# Application
NODE_ENV=development
APP_NAME=WA-MCP-Pro
APP_VERSION=1.0.0

# Server
HOST=127.0.0.1
PORT=3000

# MCP Transport
MCP_TRANSPORT=stdio
MCP_HTTP_ENABLED=false
MCP_HTTP_PORT=3001

# Database
DATABASE_URL=./storage/wa-mcp.db

# Storage Directories
SESSION_DIRECTORY=./storage/sessions
MEDIA_DIRECTORY=./storage/media
LOG_DIRECTORY=./storage/logs

# Security
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
API_KEY=

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Media
MAX_MEDIA_SIZE_MB=50

# WhatsApp Connection
WHATSAPP_AUTO_RECONNECT=true
WHATSAPP_RECONNECT_MAX_ATTEMPTS=10
WHATSAPP_MESSAGE_HISTORY_LIMIT=10000